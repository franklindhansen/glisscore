  "key": "spShape",
  "html": "\n                  <label title=\"Drag a box: a stretch of time and a range of pitch\"><input aria-label=\"Box\" type=\"radio\" name=\"spShape\" value=\"box\" checked=\"\"><span class=\"ae-ib\"><svg class=\"ae-ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 3a2 2 0 0 0-2 2\"></path><path d=\"M19 3a2 2 0 0 1 2 2\"></path><path d=\"M21 19a2 2 0 0 1-2 2\"></path><path d=\"M5 21a2 2 0 0 1-2-2\"></path><path d=\"M9 3h1\"></path><path d=\"M9 21h1\"></path><path d=\"M14 3h1\"></path><path d=\"M14 21h1\"></path><path d=\"M3 9v1\"></path><path d=\"M21 9v1\"></path><path d=\"M3 14v1\"></path><path d=\"M21 14v1\"></path></svg><span class=\"ae-lb\">Box</span></span></label>\n                  <label title=\"A range of pitch for the whole sound, like a hum\"><input aria-label=\"Band\" type=\"radio\" name=\"spShape\" value=\"band\"><span class=\"ae-ib\"><svg class=\"ae-ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><line x1=\"5\" x2=\"19\" y1=\"9\" y2=\"9\"></line><line x1=\"5\" x2=\"19\" y1=\"15\" y2=\"15\"></line></svg><span class=\"ae-lb\">Band</span></span></label>\n                  <label title=\"Every pitch for an instant, like a click or a cough\"><input aria-label=\"Moment\" type=\"radio\" name=\"spShape\" value=\"moment\"><span class=\"ae-ib\"><svg class=\"ae-ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><g transform=\"rotate(90 12 12)\"><line x1=\"5\" x2=\"19\" y1=\"9\" y2=\"9\"></line><line x1=\"5\" x2=\"19\" y1=\"15\" y2=\"15\"></line></g></svg><span class=\"ae-lb\">Moment</span></span></label>\n                ",
